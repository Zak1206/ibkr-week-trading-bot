# Exemple de configuration de base (copie de .env, secrets remplaces par CHANGE_ME).
# Copier en .env et renseigner les valeurs. Ne jamais committer le vrai .env.
# ==============================================================
# Trading Bot — .env (clean, dedup)
# Phase: IBKR paper auto-execution (budget 1000 USD)
# ==============================================================

# -----------------------------
# LLM (Groq)
# -----------------------------
GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=llama-3.1-8b-instant
# Fallback LLM (eviter 70b sauf si tu as le tier payant — quota gratuit ~100k tokens/jour)
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# -----------------------------
# Telegram
# -----------------------------
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
TELEGRAM_OFFSET_FILE=telegram_offset.json
TELEGRAM_CONFIRM_POLL_SEC=3
# Alerte Telegram quand IBKR ferme une ligne (TP/SL detecte au sync)
TELEGRAM_NOTIFY_IBKR_CLOSE=1
IBKR_SYNC_CLOSE_POLL_ENABLED=1
IBKR_SYNC_CLOSE_POLL_SEC=45
TELEGRAM_TEST=0

# -----------------------------
# Donnees marche / scan
# -----------------------------
YF_PERIOD=1mo
YF_INTERVAL=15m
DATA_PROVIDER=yahoo
DATA_FALLBACK_TO_YAHOO=1
DATA_FALLBACK_TO_FINNHUB=0
DATA_FALLBACK_TO_IBKR=1
YF_WAIT_ON_COOLDOWN=0
YF_PARALLEL_STAGGER_SEC=0.35
FINNHUB_QUOTE_TIMEOUT_SEC=12
TWELVEDATA_API_KEY=CHANGE_ME
TWELVEDATA_GUARD_ENABLED=0
TWELVEDATA_MAX_PER_MIN=8
TWELVEDATA_MAX_PER_DAY=800
FINNHUB_API_KEY=CHANGE_ME

# Delai ENTRE cycles : 10|12|15 ou auto (15 min en sequentiel, 10-12 si parallele)
SCAN_INTERVAL_MIN=auto
SCAN_ALIGN_CLOCK=0
SCAN_PARALLEL_ENABLED=0
SCAN_PARALLEL_WORKERS=2
SCAN_DECISION_MODE=hybrid
# Priorite scan: ibkr (prix Gateway + bougies Yahoo) | finnhub | yahoo
SCAN_MOMENTUM_SOURCE=ibkr
SCAN_PRIORITIZE_MOMENTUM=1
BREAKOUT_LOOKBACK_BARS=12
BREAKOUT_BUFFER_PCT=0.15
BREAKOUT_REQUIRE_VOLUME_RATIO=1.15
BREAKOUT_REQUIRE_GREEN_CANDLE=1
BREAKOUT_MIN_RSI=40
# --- Mode SNIPER LIGHT (qualite > quantite, moins strict que sniper full) ---
BUY_SNIPER_MODE=1
BUY_SNIPER_MIN_CONF=72
BUY_SNIPER_MIN_MTF=1
BUY_SNIPER_MAX_STOP_PCT=2.0
BUY_SNIPER_BREAKOUT_REQUIRED=0
BUY_SNIPER_ALT_MIN_CONF=75
BUY_SNIPER_ALT_MIN_MTF=2
RULES_MIN_CONF_BUY=72
# Entree plus tot (breakout / test range) + anti chase en haut de bougie verticale
BUY_EARLY_ENTRY_ENABLED=0
BUY_ANTICIPATE_BREAKOUT_ENABLED=0
BREAKOUT_EARLY_RELAX_MACD=0
BUY_MAX_CHASE_FROM_BREAKOUT_PCT=1.2
TRADING_REENTRY_COOLDOWN_HOURS=0
TRADING_REENTRY_BLOCK_CHASE_PCT=1.0
# Anti-chase seulement dans les N heures apres une sortie gagnante (pas a vie).
TRADING_REENTRY_BLOCK_CHASE_MAX_HOURS=4
# Prix scan vs entree (position ouverte): corrige si hors [72%, 135%]
RECONCILE_ENTRY_RATIO_LOW=0.72
RECONCILE_ENTRY_RATIO_HIGH=1.35
YF_BACKOFF_BASE_SEC=45
YF_BACKOFF_MAX_SEC=900

# -----------------------------
# Tickers / positions
# Panel 1k USD / 6 slots / actions entieres IBKR paper (pas de fractional)
# Regle sizing: ~200 USD/ligne (6 slots x ~200 = budget deploye max)
#
# Paper v3: coeur momentum + rotation secteur (juin 2026)
#   momentum: HOOD, SOFI, SMCI, PLTR, IONQ, RKLB, RGTI, COIN, UPST, ASTS
#   volatil pas cher: RIVN
#   rotation sante: CVS (MTF haussier)
# Retires (peu de signaux / mauvais fit): MSTR, SOUN, DIS
# Live + fractional (plus tard): GE, UNH, BA, XOM, OXY, AMD, SEZL, NVTS
# -----------------------------
# P5 (2026-08-03, correlations mesurees 6 mois): chirurgie de redondance.
# Retires: RGTI (0.85 avec IONQ), UPST (0.71 avec SOFI), ASTS (0.76 avec RKLB).
# 9 tickers / 6 blocs de correlation au lieu de 4. Les secteurs ne sont PAS les
# blocs de risque: HOOD/COIN/SOFI/IONQ correlent 0.55-0.77 malgre 3 secteurs.
# En reserve, decorreles et TP atteignable: CHWY, TOST, DKNG, CNC.
TICKERS_OVERRIDE=PLTR,SMCI,IONQ,HOOD,SOFI,COIN,RIVN,RKLB,CVS
TICKERS_EXTRA=
TICKERS_MANAGE_OPEN=1
POSITION_FILE=positions.json

# Sentinelle FLASH hors cycle (desactive en mode sniper)
FLASH_ENABLED=0
FLASH_CHECK_SEC=45
FLASH_SOURCE=quote_finnhub
FLASH_YF_PERIOD=5d
FLASH_YF_INTERVAL=2m
FLASH_QUOTE_LOOKBACK_SEC=180
FLASH_QUOTE_SPIKE_PCT=0.45
FLASH_QUOTE_MIN_STEP_PCT=0.08
FLASH_QUOTE_CONFIRM_SEC=40
FLASH_QUOTE_MAX_DAILY_PCT=3.5
FLASH_QUOTE_MAX_DIST_TO_HIGH_PCT=0.25
FLASH_QUOTE_PULLBACK_MIN_PCT=0.10
FLASH_QUOTE_PULLBACK_MAX_PCT=0.80
FLASH_QUOTE_MIN_TREND_PCT=0.55
FLASH_QUOTE_MIN_UP_RATIO=0.62
FLASH_QUOTE_NOTIONAL_FACTOR=0.68
FLASH_QUOTE_MAX_REMAINING_SHARE=0.18
FLASH_QUOTE_STOP_PCT=1.55
FLASH_QUOTE_TP_PCT=3.50
FLASH_QUOTE_STOP_ATR_MULT=1.50
FLASH_QUOTE_TP_ATR_MULT=3.10
FLASH_QUOTE_MIN_RSI=40
FLASH_QUOTE_MAX_RSI=78
FLASH_QUOTE_REQUIRE_MACD_CROSS=0
FLASH_QUOTE_MIN_RR=1.0
FLASH_QUOTE_SYNTH_ATR_PCT=1.1
FLASH_BREAKOUT_PCT=0.9
FLASH_DROP_PCT=0.9
FLASH_VOLUME_SPIKE=2.0
FLASH_MIN_REMAINING_SEC=20
FLASH_MIN_MOVE_ATR=0.35
FLASH_MIN_SCORE=64
FLASH_BUY_STOP_ATR_MULT=1.75
FLASH_BUY_TARGET_ATR_MULT=3.25
FLASH_HARD_SCORE=86
FLASH_COOLDOWN_MIN=20
FLASH_STATE_FILE=flash_state.json
FLASH_SELL_ENABLED=1
FLASH_SELL_MIN_PROFIT_PCT=0.2
FLASH_SELL_PEAK_MIN_SCORE=80
FLASH_SELL_PEAK_MIN_RSI=68
FLASH_SELL_PEAK_REQUIRE_ZONE=1
FLASH_SELL_HARD_PEAK_SCORE=88

# -----------------------------
# Cadre trading (USD, court terme)
# -----------------------------
TRADING_BUDGET_USD=1000
TRADING_HORIZON_DAYS=7
TRADING_RISK_PER_TRADE_PCT=1.0
TRADING_ENFORCE_RISK_CAP=1
TRADING_COUNT_PENDING_BUYS_AS_DEPLOYED=1
# 1=achat immediat si slot libre; file fin de cycle seulement si slots pleins (swap)
TRADING_BUY_EXECUTE_IMMEDIATE=1
# P3 (2026-07-10, data journal): moins de lignes, plus grosses — les lignes <150$ gagnaient
# a peine les frais (+0.92$/trade) ; frais fixes 0.35$/ordre pesent 2x moins sur 300$.
# P9 (2026-08-03): 3 -> 2 lignes. Le plancher de 0.35$/ordre est le cout dominant:
# a 350$ l'edge brut (~0.21%/trade = 0.74$) couvre a peine les frais (0.70$); a 520$
# il rapporte 1.09$ pour le meme cout. Et repartir sur 3 noms correles 0.55-0.77
# (bloc A) ne diversifiait quasiment rien tout en triplant les frais.
# Backtest 2 ans, spread 3 bps inclus: 3x350 = -173$, 2x520 = +282$, 1x1050 = +1286$.
# Ecart 2x520 vs 3x350 non significatif (IC95% [-0.541, +1.520] $/trade) mais de meme
# sens sur l'univers large (-559$ -> -274$). Note: 1 seule ligne faisait nettement mieux
# et etait la seule config positive sur les deux univers — choix assume de garder 2 lignes.
TRADING_MAX_OPEN_POSITIONS=2
# P6 (2026-08-03): 300 -> 350. Les frais sont fixes (0.70$/aller-retour), le PnL
# est proportionnel: a 300$ ils mangent 26% du brut, a 350$ 22%. Budget deploye
# 82% -> 96%. Rejeu des 68 trades du journal a ticket constant: +137.74$ a 300$,
# +168.63$ a 350$ (contre +48.46$ reels a ticket median 157$).
TRADING_TARGET_LINE_USD=520
# Plancher remonte avec la cible: a 250$ le sizing dynamique pouvait annuler
# tout le benefice du passage a 2 lignes. 520$ est un plateau (500$ -> +219$,
# 520$ -> +282$, 540$ -> +276$), pas un pic ajuste.
TRADING_DYNAMIC_MIN_LINE_USD=400
# Cash minimum laisse libre par slot vacant (achat direct sans swap)
# Passe a 0 avec 2 slots: avec une reserve de 50$, la 2e ligne n'avait que 6$ de
# marge (1096 - 50 - 520 = 526$ pour une cible de 520$). Or l'arrondi en actions
# entieres peut depasser le ticket de 40% (COIN a 148$: 520/148=3.5 -> 4 actions
# = 592$), ce qui aurait rogne la 2e ligne en silence. A 0: 576$ dispo, 56$ de marge.
TRADING_RESERVE_CASH_PER_FREE_SLOT=0
# Rotation auto IBKR si slots pleins / budget insuffisant (garde-fous anti-churn)
TRADING_SWAP_ON_FULL_SLOTS=1
TRADING_SWAP_ON_BUDGET=1
TRADING_SWAP_MIN_CONF_EDGE=6
TRADING_SWAP_MIN_NEW_CONFIDENCE=76
TRADING_SWAP_MIN_RANK_SCORE=85
TRADING_SWAP_MIN_RANK_EDGE=15
TRADING_SWAP_MIN_MOMENTUM_EDGE=1.0
TRADING_SWAP_RANK_CONF_TOLERANCE=4
TRADING_SWAP_PROTECT_PROFIT_PCT=0.35
TRADING_SWAP_MIN_HOLD_MIN=45
TRADING_SWAP_COOLDOWN_MIN=45
TRADING_SWAP_MAX_PER_DAY=1
TRADING_SWAP_AUTO_EXECUTE=0
TRADING_SWAP_AUTO_ON_CONFIRM=1
TRADING_SWAP_PENDING_TTL_SEC=7200

# -----------------------------
# Cockpit web live (navigateur)
# -----------------------------
COCKPIT_WEB_ENABLED=1
COCKPIT_WEB_HOST=127.0.0.1
COCKPIT_WEB_PORT=8765
COCKPIT_LIVE_FILE=cockpit_live.json
# Prix / PnL / dist SL-TP rafraichis entre les cycles (IBKR puis Yahoo)
COCKPIT_WEB_LIVE_PRICES=1
COCKPIT_WEB_PRICE_REFRESH_SEC=15
IBKR_PRICE_CACHE_SEC=10
SWAP_PENDING_FILE=swap_pending.json
TRADING_MIN_CONFIDENCE_ACHETER=72
TRADING_MIN_CONFIDENCE_RISK_OFF_BONUS=8
TRADING_BROKER=ibkr
# P2 (audit 10/07/2026): signal VENDRE IA coupe — 4/4 perdants, redondant avec le stop -2%.
# Sorties gerees par bracket SL/TP + intraday_flat + swaps; /confirm_sell manuel reste actif.
TRADING_SELL_SIGNAL_ENABLED=0

# Garde-fous achat techniques
BUY_CONFIRMATION_ENABLED=1
BUY_REQUIRE_MACD_CROSS=1
BUY_BLOCK_FALLING_KNIFE=1
BUY_MIN_RSI=40
BUY_REQUIRE_RR=1
BUY_MIN_RR=1.74
# SL/TP fixes: stop -2%, TP +4% (R:R 1:2)
BUY_FIXED_SL_TP_ENABLED=1
BUY_FIXED_STOP_PCT=2.0
# Stop 2% x R:R 1.75 = TP +3.5%
BUY_RR_REWARD_MULT=1.75
# --- Pack profit max (data eToro vs IBKR, juin 2026) ---
# Cap hard TP (desactive en pratique si BUY_FIXED_SL_TP=1 — TP derive du RR fixe)
BUY_MAX_TP_SIZE_THRESHOLD_USD=200
# Cap TP unifie a +3.5%
BUY_MAX_TP_PCT_SMALL=0.035
BUY_MAX_TP_PCT_LARGE=0.035
# TP dynamique ("peak lock", backtest 13/08/2026: N=26, 0/26 pire, delta +3.81%):
# une fois prix >= TP fixe, le stop remonte au TP puis suit chaque nouveau plus
# haut (verifie toutes les TRAILING_TP_CHECK_SEC) ; vend au 1er retournement,
# jamais sous le TP fixe initial. Plafond provisoire (jambe LMT technique de
# l'OCA, pas un vrai TP) = plus haut suivi x (1 + TRAILING_TP_CEILING_PCT%).
TRAILING_TP_ENABLED=1
TRAILING_TP_CHECK_SEC=300
TRAILING_TP_CEILING_PCT=15
# Stop intraday equilibre: plancher 2.5% / plafond 5% (perte typique ~3-5$ sur ~120-150$)
TRADING_MIN_STOP_ATR_MULT=2.0
TRADING_MIN_STOP_DIST_PCT=2.0
TRADING_MAX_STOP_DIST_PCT=2.0
# Quantum / volatil: marge ATR un peu plus haute, toujours plafonnee a 5%
TRADING_TICKER_STOP_ATR_MULT=IONQ:2.75,RKLB:2.5,ASTS:2.75,UPST:2.5,COIN:2.5
# Filtre proximite plus haut 3 mois: DESACTIVE (les leaders momentum peuvent etre proches du plus haut sans etre dangereux)
BUY_BLOCK_NEAR_3MO_HIGH=0

# Rappels vente en attente
SELL_PENDING_REMINDER_MIN=25

# Multi-timeframe
MTF_FILTER_ENABLED=1
MTF_PERIOD=3mo
MTF_INTERVAL=1h
MTF_MIN_BUY_SCORE=1
# Swap: MTF 1h haussier requis pour rotation
SWAP_MIN_MTF_SCORE=1

# Sortie proactive si structure 1h cassee en perte (avant stop IBKR)
# P2 (2026-07-10, data journal): DESACTIVE — 4/4 sorties perdantes (avg -3.70$ net),
# redondant depuis le stop fixe -2% (le bracket IBKR sort avant).
SELL_STRUCTURE_INVALID_ENABLED=0
SELL_STRUCTURE_INVALID_MIN_LOSS_PCT=2.0
SELL_STRUCTURE_INVALID_MAX_MTF_SCORE=-1
SELL_STRUCTURE_INVALID_MIN_WEAK_SIGNALS=2
SELL_STRUCTURE_INVALID_MAX_RSI=45

# Journal trades
JOURNAL_ENABLED=1
TRADE_JOURNAL_FILE=trades_journal.jsonl
REPORT_TOP_TRADES_N=5
REPORT_TOP_DAYS_N=5

# Fondamental + regime
FUNDAMENTAL_ENABLED=1
FUNDAMENTAL_CACHE_HOURS=24
FUNDAMENTAL_CACHE_FILE=fundamental_cache.json
FUNDAMENTAL_MIN_SCORE=50
# Exception: breakout 15m haussier + MTF ok malgre fonda faible (RIVN par defaut)
BUY_BREAKOUT_FUND_EXCEPTION_ENABLED=1
BUY_BREAKOUT_FUND_MIN_SCORE=28
BUY_BREAKOUT_FUND_EXCEPTION_TICKERS=RIVN
BUY_BREAKOUT_FUND_MIN_MTF=0
# P7 (2026-08-03): reactive apres correction d'un bug. yfinance >= 1.x ne renvoie
# plus 'earningsDate' dans .info -> earnings_days valait None sur 37/37 tickers et
# le blocage etait inoperant depuis toujours. Lecture via .calendar + timestamps.
EARNINGS_BLOCK_DAYS=2
RISK_OFF_VIX_THRESHOLD=26
# P4 (2026-07-10, data journal): sizing plat — la confiance ne predit pas le PnL
# (conf>=85: +0.92$/trade vs conf 75-84: +2.71$/trade). Pas de surponderation conviction.
FUNDAMENTAL_SIZE_BONUS_ENABLED=0
FUNDAMENTAL_SIZE_BONUS_THRESHOLD=70
FUNDAMENTAL_SIZE_BONUS_MULT=1.08

# Heartbeat
CYCLE_HEARTBEAT_ENABLED=1
CYCLE_HEARTBEAT_EVERY_CYCLES=1

# Garde-fou drawdown journalier
RISK_DD_GUARD_ENABLED=1
RISK_DAILY_DD_LIMIT_PCT=2.5

# -----------------------------
# Cap de concentration par bloc de correlation (2026-08-03)
# Le 31/07 le bot a pris SMCI+RGTI+IONQ en 2 minutes: 990$ sur 1096$ dans un seul
# et meme trade. Meme schema les 26/05, 01/06, 22/06.
# Blocs MESURES sur les rendements quotidiens (6 mois), pas des secteurs.
# Contrefactuel sur le journal: +18.74$, maxDD -28.36$ contre -36.98$, meilleur
# ratio net/ecart-type (4.42 contre 3.21). Le cap a 1 coutait -42$ (teste).
# Limite assumee: avec 3 slots, le pire cas reste 2 lignes correlees sur 3.
# 0 ou absent = desactive.
RISK_MAX_PER_THEME=2
RISK_THEME_MAP=HOOD:A,COIN:A,SOFI:A,IONQ:A,PLTR:B,RKLB:C,RIVN:D,SMCI:E,CVS:H

# Flat fin de seance: securise a partir de +1.2% (couvre frais), PAS de runner overnight.
TRADING_INTRADAY_FLAT_ENABLED=1
TRADING_INTRADAY_FLAT_MIN_BEFORE_CLOSE=30
TRADING_INTRADAY_FLAT_POLL_SEC=1
TRADING_INTRADAY_FLAT_RETRY_SEC=2
# Si le bot rate 15:30-16:00 NY: au prochain scan marche ferme, applique le flat
# en rattrapage (extended hours) jusqu'a N min apres 16h00 NY (240 = 20h00 NY).
TRADING_INTRADAY_FLAT_CATCHUP_MAX_MIN_AFTER_CLOSE=240
IBKR_FLAT_BID_WAIT_SEC=2
TRADING_INTRADAY_FLAT_SKIP_IF_LOSS=1
# P11 (2026-08-04): 0.8% -> 1.2%. Balayage sur 2 ans (config 2x520, spread 3 bps):
# 0.8% = +159$ (le pire de la plage basse), 1.0% = +257$, 1.2% = +377$, 2.0% = +387$.
# 1.2% est le SEUL seuil positif sur 4 semestres sur 4. Mecanisme: monter le seuil
# convertit des sorties FLAT en sorties TP (22% -> 26%).
# Non significatif (IC95% [-1.016, +1.522] $/trade) et l'effet s'inverse sur un
# univers de grandes caps — mais c'est attendu: 0.8% vaut 0.12xATR sur un titre a
# 6.6% d'ATR contre 0.53xATR sur une grande cap. Le seuil ne signifie pas la meme
# chose selon la volatilite. A terme il devrait etre exprime en ATR, pas en %.
TRADING_INTRADAY_FLAT_MIN_PROFIT_PCT=1.2
TRADING_INTRADAY_FLAT_ALERT_LOSS_HOLD=1
# Runners overnight desactives (0): tout gain >= flat min est securise en fin de seance.
TRADING_RUNNER_MIN_PNL_PCT=2.5
TRADING_RUNNER_MAX_OVERNIGHT=0
TRADING_RUNNER_ALERT_HOLD=0
# P1 (2026-07-10, data journal): fenetre d'entree matinale — les entrees apres 13h NY
# rapportaient +0.51 a +1.07$/trade (sous le cout des frais). 180 min = plus d'achat apres 13h NY.
# P8 (2026-08-03): resserrage a 240 min (12h00) ENVISAGE PUIS ABANDONNE.
# Erreur d'agregation: les heures qui perdaient (13h -3.33$, 14h -1.05$) sont
# TOUTES anterieures au 10/07, donc deja bloquees par P1 — 0 trade a 13h+ depuis.
# La seule heure que 240 aurait retiree est 12h, et elle est neutre:
# -0.17$/trade reel (n=12) et -0.022$ en simulation sur l'echelle de sortie complete.
# A noter: le flat a +0.8% compense la baisse du TP en fin de seance
# (P(TP) 26%->17% de 09h30 a 12h, mais P(flat) 13%->23%). Rester a 180.
# 0 = pas de blocage fin de seance (achats possibles jusqu'a la cloture / flat).
TRADING_BLOCK_BUY_MIN_BEFORE_CLOSE=0

# Mode reference PnL latent
LATENT_PRICE_MODE=intraday

# Suivi objectif quotidien (rapports Telegram /perf)
TRADING_OBJECTIVE_START_DATE=2026-05-23
TRADING_OBJECTIVE_DAYS=30

# -----------------------------
# IBKR — execution automatique
# Paper Gateway: port 4002 | Live Gateway: 4001 | TWS paper: 7497
# IBKR_ENABLED / IBKR_AUTO_EXECUTE = 0 ici, surcharges par .env.ibkr_paper
# -----------------------------
IBKR_ENABLED=0
IBKR_AUTO_EXECUTE=0
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=8
IBKR_ORDER_REF=TradingBot
# Annule les ventes SELL d'autres clients API sur tes positions (anti-interference).
# Requis aussi: Gateway → API → Master API client ID = 8
IBKR_GUARD_FOREIGN_ORDERS=1
IBKR_ACCOUNT=CHANGE_ME
IBKR_TIF=DAY
IBKR_OUTSIDE_RTH=0
IBKR_REQUIRE_MARKET_OPEN=1
IBKR_FILL_TIMEOUT_SEC=45
IBKR_EXECUTIONS_WAIT_SEC=1.5
IBKR_EXECUTIONS_RETRY_ATTEMPTS=4
IBKR_CONNECT_TIMEOUT=20
IBKR_MAX_NOTIONAL_USD=0
IBKR_PLACE_SL_TP=1
IBKR_MIN_SHARES=1
# Paper IBKR via API: cashQty/fractional quasi toujours refuse (10244) -> actions entieres direct
IBKR_ALLOW_FRACTIONAL=0
IBKR_MIN_NOTIONAL_USD=1
# Actions entieres: arrondi au plus proche du ticket (sinon floor si =0)
IBKR_WHOLE_SHARE_ROUND_NEAREST=1
# Max depassement du ticket si 2 actions plus proches que 1 (ex. HOOD ~89 USD, ticket ~136 -> 2 actions ~178 = +31%)
IBKR_WHOLE_SHARE_MAX_UPSCALE_PCT=40
IBKR_FRACTIONAL_FALLBACK_MAX_UPSCALE_PCT=40
IBKR_AUTO_FALLBACK_MANUAL=0
IBKR_CLEAR_PENDING_ON_REJECT=1
IBKR_ORDER_RETRY=1
IBKR_ORDER_RETRY_DELAY_SEC=2
IBKR_ORDER_RETRY_SIZE_MULT=0.85
IBKR_STARTUP_REQUIRED=0
# 1=live, 2=frozen, 3=delayed (~15min), 4=delayed-frozen
IBKR_MARKET_DATA_TYPE=3
# Fallback Yahoo/Finnhub si IBKR ne donne aucun prix (sizing)
IBKR_PRICE_FALLBACK_EXTERNAL=1
IBKR_PRICE_WAIT_SEC=4
IBKR_PRICE_SNAPSHOT_WAIT_SEC=5
# Prix hybride: IBKR d'abord (cockpit/report/confirm), Yahoo si indisponible
# 0 = Yahoo/externe direct (paper sans abo market data = spam Error 10168 sinon)
REFERENCE_PRICE_IBKR_FIRST=0
IBKR_SYNC_SL_TP_ENABLED=1
# P10 (2026-08-03): entrees en MIDPRICE (execution au milieu du NBBO ou mieux)
# au lieu du marche. Les entrees passaient en MarketOrder, donc traversaient le
# spread a chaque fois. Decomposition des couts sur 2 ans (2 lignes x 520$):
# commission 632$ (75%) + spread 215$ (25%). Diviser le spread par 2 vaut ~+203$.
# Repli automatique au marche si non rempli dans le delai (MIDPRICE n'est pas garanti).
# Ne s'applique qu'aux ACHATS: une sortie sur stop doit partir au marche immediatement.
# Remettre a MKT pour revenir au comportement precedent.
IBKR_ENTRY_ORDER_TYPE=MIDPRICE
IBKR_MIDPRICE_TIMEOUT_SEC=20
# 1.5 = pas d'auto-achat si 1 action > 1.5x le ticket cible (~130 USD -> max ~195 USD/action)
IBKR_WHOLE_SHARE_MAX_TICKET_MULT=1.5

# -----------------------------
# Plan pre-ouverture (desactive)
# -----------------------------
PREMARKET_PREP_ENABLED=0
PREMARKET_PREP_MAX_TICKERS=6
PREMARKET_PRICE_SOURCE=reference
PREMARKET_USE_LIVE_PRICE=1
PREMARKET_NOTIONAL_FACTOR=0.90
