# Profil paper IBKR (surcharge .env au lancement: main.py --env-file .env.ibkr_paper).
# Contient le bloc de la strategie "breakout semaine". Copier en .env.ibkr_paper.
# Profil paper IBKR (surcharge .env au lancement)
# Usage:
#   .\.venv\Scripts\python.exe main.py --env-file ".env.ibkr_paper" --budget-usd 1000 --horizon-days 7 --reset-positions --no-portfolio-prompt
#
# Archive eToro: archive/etoro_paper_2026-04-07_2026-05-22/

TRADING_BROKER=ibkr
TRADING_BUDGET_USD=1000
TRADING_OBJECTIVE_START_DATE=2026-05-23
TRADING_OBJECTIVE_DAYS=30

# Active l'execution auto (IB Gateway paper doit etre ouvert)
IBKR_ENABLED=1
IBKR_AUTO_EXECUTE=1
IBKR_PORT=4002
IBKR_CLIENT_ID=8
IBKR_ORDER_REF=TradingBot
IBKR_GUARD_FOREIGN_ORDERS=1
IBKR_MAX_NOTIONAL_USD=0
IBKR_PLACE_SL_TP=1
# Telegram quand IBKR ferme (TP/SL) — sync toutes les ~45s entre les scans
TELEGRAM_NOTIFY_IBKR_CLOSE=1
IBKR_SYNC_CLOSE_POLL_ENABLED=1
IBKR_SYNC_CLOSE_POLL_SEC=45
IBKR_REQUIRE_MARKET_OPEN=1
IBKR_CLEAR_PENDING_ON_REJECT=1
IBKR_FILL_TIMEOUT_SEC=90
IBKR_ORDER_RETRY=1
IBKR_ORDER_RETRY_DELAY_SEC=3
# Compte paper passe en donnees marche live (accepte dans Gateway) — sizing precis
IBKR_MARKET_DATA_TYPE=1
# Fallback externe (Yahoo/Finnhub) si jamais IBKR ne donne aucun prix
IBKR_PRICE_FALLBACK_EXTERNAL=1
REFERENCE_PRICE_IBKR_FIRST=0
IBKR_WHOLE_SHARE_MAX_TICKET_MULT=1.5
IBKR_WHOLE_SHARE_ROUND_NEAREST=1
IBKR_WHOLE_SHARE_MAX_UPSCALE_PCT=40
IBKR_FRACTIONAL_FALLBACK_MAX_UPSCALE_PCT=12
# Fractional shares (paper IBKR US): 0.84 action sur RKLB acceptee
IBKR_ALLOW_FRACTIONAL=0
IBKR_MIN_NOTIONAL_USD=1
PREMARKET_PREP_ENABLED=0
TRADING_MIN_STOP_ATR_MULT=2.0
TRADING_MIN_STOP_DIST_PCT=2.5
TRADING_MAX_STOP_DIST_PCT=5.0
TRADING_TICKER_STOP_ATR_MULT=IONQ:2.75,RKLB:2.5,ASTS:2.75,UPST:2.5,COIN:2.5
BUY_MAX_TP_PCT=0.035
# 2026-09-29: 1.75 -> 2.5 (TP +25% avec SL -10%, strategie "breakout semaine" en bas de fichier)
BUY_RR_REWARD_MULT=2.5
BUY_MIN_RR=1.74
TRADING_MIN_CONFIDENCE_ACHETER=62
MTF_MIN_BUY_SCORE=1
TRADING_SWAP_MAX_PER_DAY=1
# 2026-08-04: seuil pilote par le .env principal (passe a 1.2%).
# Cette ligne l'ecrasait (overlays charges avec override=True). Decommenter pour forcer 0.8%.
# TRADING_INTRADAY_FLAT_MIN_PROFIT_PCT=0.8
TRADING_INTRADAY_FLAT_MIN_BEFORE_CLOSE=30
TRADING_INTRADAY_FLAT_POLL_SEC=1
TRADING_INTRADAY_FLAT_RETRY_SEC=2
TRADING_INTRADAY_FLAT_CATCHUP_MAX_MIN_AFTER_CLOSE=240
# Pas de runner overnight: flat tous les gains >= seuil fin de seance.
TRADING_RUNNER_MAX_OVERNIGHT=0

# Cockpit web live (herite de .env si absent ici)
COCKPIT_WEB_ENABLED=1
COCKPIT_WEB_HOST=127.0.0.1
COCKPIT_WEB_PORT=8765
COCKPIT_WEB_LIVE_PRICES=1
COCKPIT_WEB_PRICE_REFRESH_SEC=5

# ---------------------------------------------------------------------------
# 2026-09-29 — STRATEGIE "BREAKOUT SEMAINE" (docs/reports/recherche-quant-2026-09-29.md)
# Backtest 2023-10 -> 2026-09, 1000$ en 1 ligne, 8 tickers: +2176$ (+62$/mois), dont +848$
# sur les 18 derniers mois, positive dans toutes les perturbations. Gain surtout du beta:
# perte attendue en marche baissier. Risque ~100$ (10% du compte) par stop.
# Retour a l'ancienne config: supprimer ce bloc + remettre BUY_RR_REWARD_MULT=1.75.
# Sauvegarde de l'ancienne version: archive/backup_2026-09-29/.env.ibkr_paper
# ---------------------------------------------------------------------------
# Entrees: breakout seul (le chemin "structure" = 82% des signaux, edge nul mesure)
BUY_SNIPER_BREAKOUT_REQUIRED=1
RISK_OFF_VIX_THRESHOLD=22
SCAN_DECISION_MODE=rules
# Timeframes du backtest: signal sur barres 1h CLOTUREES, tendance = cloture journaliere de la veille
YF_INTERVAL=1h
YF_PERIOD=3mo
MTF_INTERVAL=1d
MTF_PERIOD=1y
SCAN_COMPLETED_BARS_ONLY=1
MTF_COMPLETED_BARS_ONLY=1
SCAN_INTERVAL_MIN=30
SCAN_ALIGN_CLOCK=1
# Filtres absents du backtest (effet non teste) -> coupes
BUY_BLOCK_NEAR_3MO_HIGH=0
BUY_MAX_CHASE_FROM_BREAKOUT_PCT=0
TRADING_REENTRY_BLOCK_CHASE_PCT=0
# Sortie: SL -10% / TP +25% fixes (GTC chez IBKR), ni flat, ni trailing, ni swap, 5 seances max
BUY_FIXED_SL_TP_ENABLED=1
BUY_FIXED_STOP_PCT=10
BUY_SNIPER_MAX_STOP_PCT=10
BUY_MAX_TP_PCT_SMALL=0.25
BUY_MAX_TP_PCT_LARGE=0.25
TRADING_INTRADAY_FLAT_ENABLED=0
TRAILING_TP_ENABLED=0
TRADING_SWAP_ON_FULL_SLOTS=0
TRADING_SWAP_ON_BUDGET=0
FLASH_SELL_ENABLED=0
TRADING_MAX_HOLD_SESSIONS=5
TRADING_MAX_HOLD_MIN_BEFORE_CLOSE=30
# Taille: 1 ligne de 1000$ (et non 2 x 520$). Backtest: +62$/mois contre +41$/mois, mieux
# sur les deux moities (train +1292/+918$, 18 mois +848/+643$), meme Sharpe: gagne plus
# parce que plus de capital travaille. Prix: 1 seul titre, ~100$ (10%) par stop, pire
# trade -132$ (gap), drawdown -28%.
TRADING_MAX_OPEN_POSITIONS=1
TRADING_TARGET_LINE_USD=1000
# Risque: 1000$ x 10% = 100$ par stop. Plafond de risque releve en consequence (sinon la
# ligne serait rabotee); il redescend tout seul si le budget effectif baisse apres des pertes.
TRADING_RISK_PER_TRADE_PCT=11.5
# Garde DD journaliere: un seul stop (-10%) ne bloque pas la reentree du jour
RISK_DAILY_DD_LIMIT_PCT=15
# Reinvestissement par PALIERS (demande de Zak, 2026-09-30): ligne = 1000$ x 1.25^k, k = paliers
# franchis par le compte depuis le 29/09 -> 1250$ des 1250$, 1562$ des 1562$; 800$ sous 1000$, 640$
# sous 800$. Backtest 35 mois: +4213$ contre +2254$ en ligne fixe, mais drawdown -48% contre -26%;
# sur les 18 derniers mois: +828$ contre +820$ (rien de plus). Retour a la ligne fixe: mettre 0.
TRADING_LINE_STEP_PCT=25
TRADING_LINE_STEP_MODE=updown
# Coupe-circuit: equity realisee X% sous son plus haut depuis le lancement -> plus aucune entree,
# reprise manuelle. Doit etre AU-DELA du pire drawdown du backtest: -26% en ligne fixe, -48% avec
# paliers. A 35% avec paliers, il arrete le bot dans 100% des backtests 35 mois (+1054$ au lieu de
# +4213$). D'ou 50%. Si TRADING_LINE_STEP_PCT=0, revenir a 35.
RISK_MAX_DRAWDOWN_PCT=50
RISK_MAX_DD_START_DATE=2026-09-29
# PDT (compte reel sur marge < 25k$): 3 day trades max sur 5 jours ouvres
RISK_PDT_GUARD_ENABLED=1
RISK_PDT_MAX_DAY_TRADES=3
# Univers: regle mecanique (prix 5-200$, >=100 M$/jour, TP +3.5% atteint dans >=15% des seances
# sur 12 mois). CVS echoue (3%): retire. Effet backtest neutre en P&L, drawdown -19% -> -14%.
TICKERS_OVERRIDE=PLTR,SMCI,IONQ,HOOD,SOFI,COIN,RIVN,RKLB
